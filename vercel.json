{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/watches",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/sheet",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/cora",
      "schedule": "*/10 5-17 * * 1"
    },
    {
      "path": "/api/cron/charge",
      "schedule": "*/10 5-17 * * 1"
    },
    {
      "path": "/api/cron/housekeeping",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/send",
      "schedule": "*/10 5-17 * * 1"
    },
    {
      "path": "/api/cron/stats",
      "schedule": "*/10 12-17 * * 3"
    },
    {
      "path": "/api/cron/stats-check",
      "schedule": "0 18 * * 3"
    },
    {
      "path": "/api/cron/review",
      "schedule": "15,45 14-16 * * 5"
    },
    {
      "path": "/api/cron/review-close",
      "schedule": "15 17 * * 5"
    }
  ]
}
