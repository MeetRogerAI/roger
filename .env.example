# See README → Environment variables
DATABASE_URL=
ADMIN_SECRET=
CRON_SECRET=
RESEND_API_KEY=
X_BEARER_TOKEN=
XAI_API_KEY=
SITE_URL=https://meetroger.ai
# Roger v3 app
ADMIN_EMAILS=
EMAIL_FROM_SUPPORT="Roger support <support@meetroger.ai>"
# Optional: the base URL for links in emails. Defaults to the preview branch
# address on previews, SITE_URL on production, and localhost when working locally.
APP_URL=
# Google sign-in (optional). Both set turns on "Sign in with Google"; either
# missing hides the button and /auth/google answers 404. Register the
# redirect URI {APP_URL or SITE_URL}/auth/google/callback with the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe (test keys on preview and local, live keys on production only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Payment page's card form (Stripe.js): pk_test_… on preview and local, pk_live_… on production only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY_USD=
STRIPE_PRICE_MONTHLY_CAD=
STRIPE_PRICE_MONTHLY_HIGHER_USD=
STRIPE_PRICE_MONTHLY_HIGHER_CAD=
STRIPE_PRICE_RUN_USD=
STRIPE_PRICE_RUN_CAD=
# The "Higher monthly rate" product (metadata roger_product=higher_rate, the plan's tax code). The first invoice's
# higher-rate line is made on it, so Stripe names the line "Higher monthly rate". Unset: the plan's own product
# (the line reads "Roger Monthly"). scripts/stripe-live-setup.ts makes it and writes this variable.
STRIPE_PRODUCT_HIGHER_RATE=
