# See README → Environment variables
DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_SECRET=
CRON_SECRET=
REF_SECRET=
UNSUB_SECRET=
RESEND_API_KEY=
X_BEARER_TOKEN=
XAI_API_KEY=
SITE_URL=https://meetroger.ai
# Roger v3 app
ADMIN_EMAILS=
EMAIL_FROM_SUPPORT="Roger support <support@meetroger.ai>"
# Optional: the base URL for links in emails. Defaults to the preview branch
# address on previews, SITE_URL on production, and localhost when working locally.
APP_URL=
# Google sign-in (optional). Both set turns on "Sign in with Google"; either
# missing hides the button and /auth/google answers 404. Register the
# redirect URI {APP_URL or SITE_URL}/auth/google/callback with the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe (test keys on preview and local, live keys on production only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Payment page's card form (Stripe.js): pk_test_… on preview and local, pk_live_… on production only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY_USD=
STRIPE_PRICE_MONTHLY_CAD=
STRIPE_PRICE_MONTHLY_HIGHER_USD=
STRIPE_PRICE_MONTHLY_HIGHER_CAD=
STRIPE_PRICE_RUN_USD=
STRIPE_PRICE_RUN_CAD=
# The review bot (B3). The write token is for Production only, never Preview:
# fine-grained, MeetRogerAI/roger only, Contents and Pull requests write, from a
# machine account. The read token is optional and read-only, for Preview.
GITHUB_REVIEW_TOKEN=
GITHUB_READ_TOKEN=
# Optional model overrides (AI Gateway names). Defaults: anthropic/claude-opus-5.5
# for the review bot, anthropic/claude-sonnet-5.5 for Cora upgrades.
REVIEW_BOT_MODEL=
CORA_UPGRADE_MODEL=
# Scenario tests (SCENARIO_TARGET, SCENARIO_DATABASE_URL, the Stripe sandbox keys):
# see tests/scenarios/README.md. Never set them in Vercel.
